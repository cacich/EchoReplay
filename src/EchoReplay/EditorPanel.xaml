<UserControl x:Class="EchoReplay.EditorPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:EchoReplay" Foreground="#EFF7F5">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid x:Name="InteractionRoot">
      <Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,10"><TextBlock Text="音檔庫" FontSize="20" FontWeight="SemiBold"/><WrapPanel Margin="0,10,0,0"><Button Content="匯入音檔" Click="Import_Click" Padding="10,7" Margin="0,0,8,0"/><Button Content="重新整理" Click="Refresh_Click" Padding="10,7"/></WrapPanel><TextBox x:Name="SearchBox" Margin="0,10,0,0" ToolTip="搜尋音檔名稱" TextChanged="Search_Changed"/><TextBlock Text="搜尋名稱 · 雙擊音檔開始剪輯" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/></StackPanel>
        <ListBox x:Name="ClipsList" Grid.Row="1" Background="#10191C" Foreground="#EFF7F5" BorderBrush="#405459" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="Open_Click">
          <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Name}"/><TextBlock Text="{Binding Detail}" FontSize="11" Foreground="#92A6A8" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2" Margin="0,10,0,0"><Button Content="開啟選取音檔" Click="Open_Click" Style="{StaticResource PrimaryButton}"/><WrapPanel Margin="0,8,0,0"><Button Content="改名" Click="Rename_Click" Padding="10,7" Margin="0,0,6,0"/><Button Content="資料夾" Click="Folder_Click" Padding="10,7" Margin="0,0,6,0"/><Button Content="刪除" Click="Delete_Click" Padding="10,7" Foreground="#FFCC94"/></WrapPanel></StackPanel>
      </Grid>
      <DockPanel Grid.Column="2" LastChildFill="True">
        <StackPanel x:Name="EditorFooter" IsEnabled="False" DockPanel.Dock="Bottom" Margin="0,10,8,0">
            <WrapPanel><Button Content="保存編輯進度" Click="SaveProject_Click" Margin="0,0,8,8" Padding="12,9"/><ComboBox x:Name="FormatBox" SelectedIndex="0" Width="158" Margin="0,0,8,8"><ComboBoxItem Content="MP3 · 192 kbps"/><ComboBoxItem Content="MP3 · 320 kbps"/><ComboBoxItem Content="WAV · 無損"/></ComboBox><Button Content="匯出成品" Click="Export_Click" Style="{StaticResource PrimaryButton}" Padding="16,9" Margin="0,0,0,8"/></WrapPanel>
            <TextBlock x:Name="PreviewNotice" Text="試聽聲音也會被目前的電腦錄音收錄。背景錄音會持續；如不希望收錄試聽，可自行暫停錄音。" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/>
        </StackPanel>
      <ScrollViewer x:Name="EditorScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,8,0">
          <TextBlock x:Name="ClipTitle" Text="選擇音檔，留下想要的幾秒" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock x:Name="ClipInfo" Text="支援 WAV／MP3。原始錄音保持完整，剪輯後另存成品。" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,12"/>
          <StackPanel x:Name="EditorBody" IsEnabled="False">
            <WrapPanel Margin="0,0,0,10"><Button x:Name="PreviewButton" Content="▶ 播放選取範圍" Click="Preview_Click" Padding="12,8" Margin="0,0,8,4"/><Button Content="■ 停止" Click="Stop_Click" Padding="12,8" Margin="0,0,12,4"/><CheckBox x:Name="LoopBox" Content="循環試聽" Checked="Loop_Changed" Unchecked="Loop_Changed"/></WrapPanel>
            <local:WaveformView x:Name="Waveform" Height="130" ToolTip="拖曳選取範圍；滑鼠滾輪縮放。下方時間欄可精確輸入秒數。"/>
            <Slider x:Name="SeekSlider" Minimum="0" Maximum="1" Margin="0,8,0,0" PreviewMouseLeftButtonDown="Seek_Begin" PreviewMouseLeftButtonUp="Seek_End" PreviewKeyUp="Seek_KeyUp"/>
            <TextBlock x:Name="PlaybackTime" Text="00:00.000" FontSize="11" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/>
            <WrapPanel Margin="0,4,0,6"><TextBlock Text="最後" VerticalAlignment="Center" Margin="0,0,8,4"/><Button Content="5 秒" Tag="5" Click="Tail_Click" Padding="9,6" Margin="0,0,6,4"/><Button Content="10 秒" Tag="10" Click="Tail_Click" Padding="9,6" Margin="0,0,6,4"/><Button Content="15 秒" Tag="15" Click="Tail_Click" Padding="9,6" Margin="0,0,6,4"/><Button Content="30 秒" Tag="30" Click="Tail_Click" Padding="9,6" Margin="0,0,6,4"/><Button Content="全選" Click="SelectAll_Click" Padding="9,6" Margin="0,0,6,4"/><Button Content="放大選取" Click="Zoom_Click" Padding="9,6" Margin="0,0,6,4"/><Button Content="顯示全部" Click="Fit_Click" Padding="9,6" Margin="0,0,6,4"/><Button Content="←" Tag="-0.5" Click="Pan_Click" Padding="12,6" Margin="0,0,6,4"/><Button Content="→" Tag="0.5" Click="Pan_Click" Padding="12,6" Margin="0,0,6,4"/></WrapPanel>
            <WrapPanel Margin="0,0,0,10"><TextBlock Text="起點（秒）" VerticalAlignment="Center"/><TextBox x:Name="StartBox" Width="83" Margin="5,0,10,0"/><TextBlock Text="終點" VerticalAlignment="Center"/><TextBox x:Name="EndBox" Width="83" Margin="5,0,8,0"/><Button Content="套用範圍" Click="Range_Click" Padding="9,6"/><TextBlock x:Name="SelectionText" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="10,0,0,0"/></WrapPanel>
            <WrapPanel Margin="0,0,0,12"><Button Content="保留選取範圍" Tag="trim" Click="Edit_Click" Padding="10,8" Margin="0,0,6,6"/><Button Content="刪除片段並接合" Tag="delete" Click="Edit_Click" Padding="10,8" Margin="0,0,6,6"/><Button Content="選取範圍靜音" Tag="mute" Click="Edit_Click" Padding="10,8" Margin="0,0,6,6"/><Button x:Name="UndoButton" Content="復原" Click="Undo_Click" Padding="10,8" Margin="0,0,6,6"/><Button x:Name="RedoButton" Content="重做" Click="Redo_Click" Padding="10,8" Margin="0,0,6,6"/></WrapPanel>
            <Border Background="#1A2427" CornerRadius="10" Padding="14" Margin="0,0,0,12"><StackPanel><TextBlock Text="音軌與淡入淡出" FontWeight="SemiBold"/><TextBlock x:Name="TrackInfo" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,8"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel><CheckBox x:Name="SystemEnabled" Content="電腦聲音" IsChecked="True"/><Slider x:Name="SystemVolume" Minimum="0" Maximum="2" Value="1" TickFrequency="0.05" IsSnapToTickEnabled="True"/><TextBlock Text="{Binding ElementName=SystemVolume, Path=Value, StringFormat={}{0:P0}}" Foreground="{StaticResource MutedBrush}"/></StackPanel>
                <StackPanel Grid.Column="2" x:Name="MicrophoneControls"><CheckBox x:Name="MicrophoneEnabled" Content="麥克風" IsChecked="True"/><Slider x:Name="MicrophoneVolume" Minimum="0" Maximum="2" Value="1" TickFrequency="0.05" IsSnapToTickEnabled="True"/><TextBlock Text="{Binding ElementName=MicrophoneVolume, Path=Value, StringFormat={}{0:P0}}" Foreground="{StaticResource MutedBrush}"/></StackPanel>
              </Grid>
              <StackPanel x:Name="GameControls" Visibility="Collapsed" Margin="0,6,0,0"><CheckBox x:Name="GameEnabled" Content="遊戲音軌" IsChecked="True"/><Slider x:Name="GameVolume" Minimum="0" Maximum="2" Value="1" TickFrequency="0.05" IsSnapToTickEnabled="True"/><TextBlock Text="{Binding ElementName=GameVolume, Path=Value, StringFormat={}{0:P0}}" Foreground="{StaticResource MutedBrush}"/></StackPanel>
              <WrapPanel Margin="0,8,0,0"><TextBlock Text="淡入（秒）" VerticalAlignment="Center"/><TextBox x:Name="FadeInBox" Text="0" Width="60" Margin="5,0,10,0"/><TextBlock Text="淡出" VerticalAlignment="Center"/><TextBox x:Name="FadeOutBox" Text="0" Width="60" Margin="5,0,8,0"/><Button Content="套用音量與淡化" Click="Effects_Click" Padding="9,6"/></WrapPanel>
            </StackPanel></Border>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
      </DockPanel>
    </Grid>
    <Grid Grid.Row="1" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="StatusText" Text="錄音與匯出成品會列在這裡。" Foreground="{StaticResource MutedBrush}"/><ProgressBar x:Name="WorkProgress" Visibility="Collapsed" Margin="0,7,12,0" Maximum="100"/></StackPanel><Button x:Name="CancelButton" Grid.Column="1" Content="取消" Visibility="Collapsed" Click="Cancel_Click" Padding="12,6"/></Grid>
  </Grid>
</UserControl>
