<Window x:Class="EchoReplay.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:EchoReplay" Style="{StaticResource {x:Type Window}}" Title="EchoReplay · 聲音回放" Width="1180" Height="880" MinWidth="1000" MinHeight="680" WindowStartupLocation="CenterScreen">
  <Grid Margin="28,22,28,20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="EchoReplay" FontSize="28" FontWeight="Bold"/><TextBlock Text="讓剛剛那一刻，留下聲音。" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel>
      <Button Grid.Column="1" Content="縮到系統匣 ↘" Click="Hide_Click" VerticalAlignment="Center" ToolTip="錄音會繼續，可用快捷鍵或系統匣圖示叫回視窗"/>
    </Grid>
    <Border Grid.Row="1" Background="#253536" CornerRadius="8" Padding="12,10" Margin="0,0,0,12"><TextBlock x:Name="NoticeText" Text="準備錄音。音訊只會在按下儲存後寫入輸出資料夾。" Foreground="#CCE8DC"/></Border>
    <TabControl x:Name="MainTabs" Grid.Row="2" Background="Transparent" BorderThickness="0" Padding="0,16,0,0">
      <TabItem Header="即時回放"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
        <Border Style="{StaticResource Card}" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock x:Name="RecordingStatus" Text="● 準備中" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,8,0,2"><TextBlock x:Name="BufferTime" Text="00:00" FontSize="52" FontWeight="Light" FontFamily="Segoe UI"/><TextBlock x:Name="RetentionLabel" Text=" / 05:00" FontSize="22" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom" Margin="2,0,0,10"/></StackPanel><TextBlock Text="已保留的最近音訊 · 舊內容會自動覆蓋" Foreground="{StaticResource MutedBrush}"/><ProgressBar x:Name="BufferProgress" Maximum="100" Margin="0,16,30,0"/></StackPanel>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Width="235"><Button x:Name="SaveButton" Content="儲存最近音訊" Style="{StaticResource PrimaryButton}" Click="Save_Click" Padding="16,15"/><TextBlock x:Name="SaveHotkeyLabel" Text="Ctrl + Alt + F9" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,12"/><Button x:Name="RecordButton" Content="開始錄音" Click="Record_Click"/></StackPanel>
        </Grid></Border>
        <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock x:Name="SystemSourceTitle" Text="電腦聲音" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="SystemDeviceText" Text="連接播放裝置…" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><ProgressBar x:Name="SystemMeter" Maximum="100"/><TextBlock x:Name="SystemLevelText" Text="等待聲音" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/></StackPanel></Border>
          <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="麥克風" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="MicDeviceText" Text="連接麥克風…" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><ProgressBar x:Name="MicMeter" Maximum="100"/><TextBlock x:Name="MicLevelText" Text="等待聲音" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/></StackPanel></Border>
        </Grid>
        <Border x:Name="GameSourceCard" Visibility="Collapsed" Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="遊戲音軌" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="GameDeviceText" Text="等待遊戲啟動…" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,10"/><ProgressBar x:Name="GameMeter" Maximum="100"/><TextBlock x:Name="GameLevelText" Text="等待聲音" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,8,0,0"/></StackPanel></Border>
        <Border Style="{StaticResource Card}"><StackPanel><DockPanel><Button Content="開啟輸出資料夾" Click="OpenOutput_Click" DockPanel.Dock="Right" Padding="12,7"/><TextBlock Text="最近儲存" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><TextBlock x:Name="LastSavedText" Text="還沒有儲存片段。發生有趣的事後，再按下儲存即可。" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,12"/><StackPanel Orientation="Horizontal"><Button x:Name="PlayButton" Content="剪輯／試聽最新錄音" Click="Play_Click" IsEnabled="False" Margin="0,0,8,0"/><Button x:Name="ShowClipButton" Content="查看音檔" Click="ShowClip_Click" IsEnabled="False"/></StackPanel></StackPanel></Border>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem x:Name="LibraryTab" Header="音檔庫與剪輯"><local:EditorPanel x:Name="Editor"/></TabItem>
      <TabItem Header="設定"><DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0"><TextBlock Text="更換保留時間、錄音模式、程式或裝置，會重新累積錄音；請先保存需要的片段。" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,10"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="還原未套用變更" Click="ResetSettings_Click" Margin="0,0,10,0"/><Button x:Name="ApplyButton" Content="套用設定" Style="{StaticResource PrimaryButton}" Click="Apply_Click"/></StackPanel></StackPanel>
        <ScrollViewer x:Name="SettingsScroller" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,8,0">
          <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="錄音與檔案" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="保留最近幾分鐘" Style="{StaticResource Label}"/><ComboBox x:Name="MinutesBox"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="音檔格式" Style="{StaticResource Label}"/><TextBlock Text="WAV · 48 kHz / 16-bit" Margin="0,9,0,0"/></StackPanel></Grid><TextBlock Text="輸出資料夾" Style="{StaticResource Label}" Margin="0,16,0,8"/><DockPanel><Button Content="瀏覽…" DockPanel.Dock="Right" Click="Browse_Click" Margin="10,0,0,0"/><TextBox x:Name="OutputBox"/></DockPanel><CheckBox x:Name="SeparateBox" Content="另外儲存電腦聲音及麥克風分軌（方便後製）"/></StackPanel></Border>
          <Border x:Name="CaptureModeCard" Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel>
            <TextBlock Text="錄音模式" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <ComboBox x:Name="CaptureModeBox" SelectionChanged="CaptureMode_Changed"><ComboBoxItem Tag="Device" Content="指定播放裝置（相容模式）"/><ComboBoxItem Tag="System" Content="所有程式（排除 EchoReplay 試聽）"/><ComboBoxItem Tag="Applications" Content="語音聊天／遊戲分軌（排除 EchoReplay 試聽）"/></ComboBox>
            <TextBlock x:Name="CaptureModeHelp" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/>
            <StackPanel x:Name="ApplicationSettings" Margin="0,12,0,0" Visibility="Collapsed">
              <DockPanel><Button Content="重新整理程式" Click="RefreshProcesses_Click" DockPanel.Dock="Right" Padding="10,6"/><TextBlock Text="先啟動 Discord 和遊戲，再選擇實際程式。" VerticalAlignment="Center"/></DockPanel>
              <TextBlock Text="語音聊天程式（例如 Discord.exe）" Style="{StaticResource Label}" Margin="0,12,0,8"/><ComboBox x:Name="VoiceProcessBox" IsEditable="True" IsTextSearchEnabled="True"/>
              <TextBlock Text="遊戲程式（可留白，只錄語音與麥克風）" Style="{StaticResource Label}" Margin="0,12,0,8"/><ComboBox x:Name="GameProcessBox" IsEditable="True" IsTextSearchEnabled="True"/>
              <TextBlock Text="也可直接輸入 .exe 名稱。程式關閉後會等待重啟；此模式固定保存分軌，不會錄其他程式。" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,10,0,0"/>
              <TextBlock Text="遊戲混音音量（分軌保留原音量）" Style="{StaticResource Label}" Margin="0,12,0,8"/><Slider x:Name="GameGainSlider" Minimum="0" Maximum="2" TickFrequency="0.1" IsSnapToTickEnabled="True"/><TextBlock Text="{Binding ElementName=GameGainSlider, Path=Value, StringFormat={}{0:P0}}" Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><DockPanel><Button Content="重新整理裝置" Click="RefreshDevices_Click" DockPanel.Dock="Right" Padding="10,6"/><TextBlock Text="音訊來源" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><TextBlock Text="播放裝置 · 僅用於「指定播放裝置」模式" Style="{StaticResource Label}" Margin="0,14,0,8"/><ComboBox x:Name="OutputDeviceBox" DisplayMemberPath="Name" SelectedValuePath="Id"/><CheckBox x:Name="MicrophoneBox" Content="同時錄製麥克風"/><ComboBox x:Name="MicrophoneDeviceBox" DisplayMemberPath="Name" SelectedValuePath="Id"/><TextBlock Text="混音音量（分軌保留原始音量）" Style="{StaticResource Label}" Margin="0,16,0,8"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="SystemGainLabel" Text="電腦聲音"/><Slider x:Name="SystemGainSlider" Minimum="0" Maximum="2" TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="0,8,0,0"/><TextBlock Text="{Binding ElementName=SystemGainSlider, Path=Value, StringFormat={}{0:P0}}" Foreground="{StaticResource MutedBrush}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="麥克風"/><Slider x:Name="MicGainSlider" Minimum="0" Maximum="2" TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="0,8,0,0"/><TextBlock Text="{Binding ElementName=MicGainSlider, Path=Value, StringFormat={}{0:P0}}" Foreground="{StaticResource MutedBrush}"/></StackPanel></Grid></StackPanel></Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="快捷鍵" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="點選欄位後直接按下組合鍵，需包含 Ctrl 或 Alt。" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,14"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="儲存最近音訊" Style="{StaticResource Label}"/><TextBox x:Name="SaveKeyBox" IsReadOnly="True" PreviewKeyDown="Hotkey_PreviewKeyDown"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="顯示／隱藏介面" Style="{StaticResource Label}"/><TextBox x:Name="ShowKeyBox" IsReadOnly="True" PreviewKeyDown="Hotkey_PreviewKeyDown"/></StackPanel></Grid></StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="啟動與背景執行" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/><CheckBox x:Name="RecordOnLaunchBox" Content="啟動程式後自動開始錄音"/><CheckBox x:Name="RunAtLoginBox" Content="登入 Windows 時自動執行（直接進入系統匣）"/><CheckBox x:Name="StartHiddenBox" Content="手動開啟程式時，也直接縮到系統匣"/><TextBlock Text="關閉或最小化視窗會繼續在背景執行。要完全停止程式，請使用系統匣選單的「結束」。" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/></StackPanel></Border>
        </StackPanel></ScrollViewer>
      </DockPanel></TabItem>
    </TabControl>
    <DockPanel Grid.Row="3" Margin="0,15,0,0"><TextBlock Text="本機錄製 · 不上傳音訊" Foreground="{StaticResource MutedBrush}" FontSize="12" DockPanel.Dock="Right"/><TextBlock x:Name="FooterText" Text="Ctrl + Alt + F10  喚出介面" Foreground="{StaticResource MutedBrush}" FontSize="12"/></DockPanel>
  </Grid>
</Window>
